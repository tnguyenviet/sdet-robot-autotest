# OpenAI API Key for NLP Test Generator
OPENAI_API_KEY=your-api-key-here

# Environment Configuration
ENVIRONMENT=development

# Browser Settings
BROWSER=chrome
HEADLESS=true

# Timeouts (seconds)
IMPLICIT_WAIT=10
PAGE_LOAD_TIMEOUT=30

# SauceDemo Credentials (for reference - these are public demo credentials)
SAUCE_STANDARD_USER=standard_user
SAUCE_LOCKED_USER=locked_out_user
SAUCE_PROBLEM_USER=problem_user
SAUCE_PERFORMANCE_USER=performance_glitch_user
SAUCE_ERROR_USER=error_user
SAUCE_VISUAL_USER=visual_user
SAUCE_PASSWORD=secret_sauce
